{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "DATABASE_POOL_SIZE",
    "PUBLIC_ENABLE_EXPENSE_DOCUMENTS",
    "S3_UPLOAD_BUCKET",
    "S3_UPLOAD_KEY",
    "S3_UPLOAD_SECRET",
    "S3_UPLOAD_REGION",
    "S3_UPLOAD_ENDPOINT",
    "S3_UPLOAD_PUBLIC_URL",
    "BETTER_AUTH_SECRET",
    "CRON_SECRET",
    "EMAIL_UNSUBSCRIBE_SECRET",
    "WEB_ORIGINS",
    "BETTER_AUTH_URL",
    "TRUST_PROXY",
    "PUBLIC_DEFAULT_CURRENCY_CODE",
    "SIGNUP_MODE",
    "SMTP_HOST",
    "SMTP_PORT"
  ],
  "tasks": {
    "ci-checks": {
      "dependsOn": [
        "//#check-formatting:root",
        "//#check-types:root",
        "check-formatting",
        "lint",
        "check-types",
        "i18n",
        "build",
        "generate-openapi",
        "test",
        "test:integration"
      ]
    },
    "build": {
      "dependsOn": ["^build", "check-types", "@spliit/db#prisma-generate"],
      "outputs": ["dist/**", "build/**", ".vite/**"]
    },
    "dev": {
      "dependsOn": ["@spliit/db#prisma-generate"],
      "cache": false,
      "persistent": true
    },
    "prisma-generate": {
      "inputs": [
        "prisma/schema.prisma",
        "prisma.config.ts",
        "package.json",
        "$TURBO_ROOT$/bun.lock"
      ],
      "outputs": ["src/generated/prisma/**"]
    },
    "prisma-migrate": {
      "cache": false,
      "passThroughEnv": ["DATABASE_URL"]
    },
    "lint": {
      "dependsOn": ["^build", "@spliit/db#prisma-generate"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/.oxlintrc.json"]
    },
    "lint:fix": {
      "dependsOn": ["^build", "@spliit/db#prisma-generate"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/.oxlintrc.json"],
      "cache": false
    },
    "check-formatting": {
      "inputs": [
        "**/*.{js,cjs,mjs,jsx,ts,cts,mts,tsx,json,jsonc,json5,yaml,yml,toml,html,css,scss,less,md,mdx,graphql,gql}",
        "!src/routeTree.gen.ts",
        "!src/components/ui/**",
        "!src/generated/**",
        "$TURBO_ROOT$/oxfmt.config.ts",
        "$TURBO_ROOT$/package.json"
      ]
    },
    "format": {
      "cache": false,
      "inputs": [
        "**/*.{js,cjs,mjs,jsx,ts,cts,mts,tsx,json,jsonc,json5,yaml,yml,toml,html,css,scss,less,md,mdx,graphql,gql}",
        "!src/routeTree.gen.ts",
        "!src/components/ui/**",
        "!src/generated/**",
        "$TURBO_ROOT$/oxfmt.config.ts",
        "$TURBO_ROOT$/package.json"
      ]
    },
    "//#check-formatting:root": {
      "inputs": [
        "oxfmt.config.ts",
        ".oxlintrc.json",
        "package.json",
        "turbo.json",
        "tsconfig.json",
        "vercel.json",
        "api/**",
        "*.md",
        ".devcontainer/**",
        ".github/**",
        "docs/**",
        "handoff/**",
        "compose.dev.yaml",
        "compose.dokploy.yaml",
        "doctor.config.json"
      ]
    },
    "//#format:root": {
      "cache": false,
      "inputs": [
        "oxfmt.config.ts",
        ".oxlintrc.json",
        "package.json",
        "turbo.json",
        "tsconfig.json",
        "vercel.json",
        "api/**",
        "*.md",
        ".devcontainer/**",
        ".github/**",
        "docs/**",
        "handoff/**",
        "compose.dev.yaml",
        "compose.dokploy.yaml",
        "doctor.config.json"
      ]
    },
    "check-types": {
      "dependsOn": ["^build", "@spliit/db#prisma-generate"]
    },
    "//#check-types:root": {
      "dependsOn": ["@spliit/db#prisma-generate"],
      "inputs": ["api/**/*.ts", "tsconfig.json", "$TURBO_ROOT$/bun.lock"]
    },
    "i18n": {},
    "generate-openapi": {
      "dependsOn": ["^build", "@spliit/db#prisma-generate"],
      "outputs": ["openapi.json"]
    },
    "test": {
      "dependsOn": ["^build", "@spliit/db#prisma-generate"],
      "outputs": ["coverage/**", ".vitest/**"]
    },
    "test:integration": {
      "dependsOn": ["^build", "@spliit/db#prisma-generate"],
      "cache": false,
      "passThroughEnv": ["DATABASE_URL"]
    }
  }
}
