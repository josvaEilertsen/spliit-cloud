{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "bun install",
  "buildCommand": "bun run build",
  "outputDirectory": "apps/web/dist",
  "functions": {
    "api/index.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    { "path": "/api/cron/materialize", "schedule": "*/5 * * * *" },
    { "path": "/api/cron/reconcile", "schedule": "*/30 * * * *" },
    { "path": "/api/cron/anonymous-cleanup", "schedule": "30 3 * * *" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/registerSW.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/trpc/(.*)", "destination": "/api/index" },
    { "source": "/auth/(.*)", "destination": "/api/index" },
    { "source": "/health", "destination": "/api/index" },
    { "source": "/health/(.*)", "destination": "/api/index" },
    { "source": "/.well-known/(.*)", "destination": "/api/index" },
    { "source": "/email/(.*)", "destination": "/api/index" },
    { "source": "/groups/(.*)/export/(.*)", "destination": "/api/index" },
    {
      "source": "/groups/(.*)/expenses/export/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/groups/(.*)/expenses/report-data",
      "destination": "/api/index"
    },
    { "source": "/account/export/(.*)", "destination": "/api/index" },
    { "source": "/imports/(.*)", "destination": "/api/index" },
    { "source": "/openapi.json", "destination": "/api/index" },
    { "source": "/docs", "destination": "/api/index" },
    { "source": "/api/cron/(.*)", "destination": "/api/index" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
